# Generated from client/src/robot/spec.ts by make assets. Do not edit.
format: xrdf
format_version: 2.0

default_joint_positions:
  base: 0
  shoulder: 0.3
  elbow: 0.6
  wrist: -0.9
  flange: 0

cspace:
  joint_names:
    - "base"
    - "shoulder"
    - "elbow"
    - "wrist"
    - "flange"
  acceleration_limits: [10, 10, 10, 10, 10]
  jerk_limits: [5000, 5000, 5000, 5000, 5000]

tool_frames: ["pad"]

world_collision:
  geometry: "arm_spheres"

self_collision:
  geometry: "arm_spheres"
  ignore:
    turret: ["upper_arm", "forearm"]
    upper_arm: ["forearm", "wrist_link"]
    forearm: ["wrist_link", "flange_link"]
    wrist_link: ["flange_link", "pad"]
    flange_link: ["pad"]

